# Backend (API server)
PORT=3001
# URL Next.js uses to proxy /api/* (set in frontend env or root when running monorepo)
BACKEND_URL=http://127.0.0.1:3001

# Clerk — https://dashboard.clerk.com (used by frontend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase — https://supabase.com/dashboard (used by frontend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
